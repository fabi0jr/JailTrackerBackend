// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {

  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String
  telefone String
  endereco String

  movimentacoes Movimentacao[]
  prisoners Prisoner[]
  visitors Visitor[]
  visits Visit[]

}

model Prisoner {

  id Int @id @default(autoincrement())
  nome String
  estadoCivil String
  nomePai String
  nomeMae String
  cpf String @unique
  delito String
  reicidencia Boolean @default(false)
  dataNasc DateTime
  pavilhao String
  cela String

  foto String?

  naSolitaria Boolean @default(false)
  dataFimSolitaria DateTime?

  movimentacoes Movimentacao[]

  criadorId Int
  criador User @relation(fields: [criadorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits Visit[]

}

model Visitor {

  id Int @id @default(autoincrement())
  nome String
  cpf String @unique
  telefone String

  criadorId Int
  criador User @relation(fields: [criadorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  visits Visit[]

}

model Visit {
  id Int @id @default(autoincrement())
  dataVisita DateTime
  horaEntrada String
  horaSaida String

  status Boolean @default(false)

  visitorId Int
  visitor Visitor @relation(fields: [visitorId], references: [id])

  prisonerId Int
  prisoner Prisoner @relation(fields: [prisonerId], references: [id])
  
  criadorId Int
  criador User @relation(fields: [criadorId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Movimentacao {
  id Int @id @default(autoincrement())
  tipo String
  descricao String
  dataMovimentacao DateTime @default(now())

  prisonerId Int
  prisoner Prisoner @relation(fields: [prisonerId], references: [id])

  criadorId Int
  criador User @relation(fields: [criadorId], references: [id])
}
